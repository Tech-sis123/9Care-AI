generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id                    String   @id @default(uuid())
  phone_number          String   @unique
  email                 String?  @unique
  /// Set when the patient confirms the email via the verification link
  email_verified_at     DateTime?
  /// Optional login name for patients without a usable email (lowercase)
  username              String?  @unique
  password_hash         String?
  name                  String?
  /// What she enters; `age` is worked out from it and kept current (see src/utils/dateOfBirth.ts)
  date_of_birth         DateTime? @db.Date
  age                   Int?
  education_level       String?
  occupation            String?
  marital_status        String?
  address               String?
  religion              String?
  ethnicity             String?
  language_preference   String?  // en/pidgin
  emergency_contact_name String?
  emergency_contact_relationship String?
  emergency_contact_phone String?
  primary_doctor_id     String?
  /// not_started | in_progress | submitted
  intake_status         String   @default("not_started")
  /// Set on first successful questionnaire submit; used for 7-day edit window
  intake_first_submitted_at DateTime?
  intake_last_saved_at  DateTime?
  /// Last time the patient opened the app (site visit tracking)
  last_seen_at          DateTime?
  /// Count of unique calendar-day visits to the patient app
  site_visit_count      Int      @default(0)
  /// WhatsApp number with country code (+234…); may differ from the OTP phone_number
  whatsapp_number       String?
  /// null = never asked, true = agreed to WhatsApp updates/reminders, false = withdrew consent
  whatsapp_consent      Boolean?
  /// When she ticked the consent box (cleared if she withdraws)
  whatsapp_consent_at   DateTime?
  /// Set once she confirms a code sent to whatsapp_number (not built yet); reset when the number changes
  whatsapp_verified     Boolean  @default(false)
  whatsapp_verified_at  DateTime?
  /// Last time she regained access through account recovery (shows the WhatsApp pop-up)
  account_recovered_at  DateTime?
  created_at            DateTime @default(now())

  pregnancies           Pregnancy[]
  intake_responses      IntakeResponse[]
  risk_assessments      RiskAssessment[]
  symptoms              Symptom[]
  danger_alerts         DangerAlert[]
  appointments          Appointment[]
  education_progress    EducationProgress[]
  site_visits           PatientSiteVisit[]
  education_comments    EducationComment[]

  @@map("patients")
}

model Doctor {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  /// Optional. Used for SMS / WhatsApp alerts (onboarding, danger signs).
  phone_number  String?
  /// Days of the week the doctor is available in clinic (e.g. ["Monday"]).
  clinic_days   String[] @default([])
  role          String   // doctor / department_head
  created_at    DateTime @default(now())

  danger_alerts DangerAlert[]
  appointments  Appointment[]
  education_comments EducationComment[]

  @@map("doctors")
}

model Pregnancy {
  id                   String   @id @default(uuid())
  patient_id           String
  lmp_date             DateTime?
  edd_computed         DateTime?
  current_ega_weeks    Int?
  booking_weight       Float?
  booking_height       Float?
  booking_bp_systolic  Int?
  booking_bp_diastolic Int?
  blood_group          String?
  genotype             String?
  rhesus               String?
  rvd_status           String?
  vdrl                 String?
  pcv                  Float?
  hep_b                String?
  /// Malaria parasite result
  malaria_parasite     String?
  urinalysis           String?
  /// Tetanus toxoid (TT) history / doses
  tetanus_history      String?
  /// Intermittent preventive treatment for malaria (IPT)
  ipt_history          String?
  /// Ultrasound scan
  uss_date             DateTime?
  uss_ega_weeks        Int?
  uss_notes            String?
  /// Previously booked ANC at another facility
  booked_anc           Boolean?
  booked_anc_facility  String?
  /// Gestational age at booking (weeks)
  booking_ga_weeks     Int?
  /// Date of ANC booking visit
  booking_date         DateTime?
  /// Free-text booking / ANC history notes (doctor-entered)
  booking_history      String?
  /// Hepatitis C result
  hep_c                String?
  /// Random blood glucose
  rbg                  String?
  /// Oral glucose tolerance test
  ogtt                 String?
  /// Extra labs / ad-hoc investigations (JSON: protein, glucose, additional[], request, etc.)
  extra_labs           Json?
  /// Doctor-logged vitals history (array of entries)
  vitals_log           Json?
  /// Prescribed meds + IPT/TT doses with GA (JSON object)
  drugs_vaccines       Json?
  /// Scans during pregnancy (array: date, ga, notes)
  scans_log            Json?
  /// Current examination findings (lie, presentation, SFH, fetal heart)
  examination          Json?
  /// Persistent doctor remarks — shown every consultation once set
  important_remarks    String?
  gravidity            Int?
  parity               Int?
  /// High-risk condition ids ticked by a doctor (see src/modules/risk/conditions.ts)
  risk_factors         Json?

  // ── Delivery (entered by the patient from 30 weeks; set = delivered) ──
  delivery_date              DateTime?
  delivery_recorded_at       DateTime?
  delivery_had_complications Boolean?
  /// One yes/no field per complication (kept separate for later model training)
  comp_antepartum_hemorrhage          Boolean?
  comp_premature_rupture_of_membranes Boolean?
  comp_prolonged_labour               Boolean?
  comp_postpartum_hemorrhage          Boolean?
  comp_preeclampsia                   Boolean?
  comp_eclampsia                      Boolean?
  comp_other                          Boolean?
  comp_other_details                  String?
  /// alive_well | alive_with_complications | stillbirth
  delivery_outcome           String?
  /// vaginal | caesarean
  delivery_mode              String?

  patient              Patient  @relation(fields: [patient_id], references: [id])

  @@map("pregnancies")
}

model IntakeResponse {
  id            String   @id @default(uuid())
  patient_id    String
  domain        String   // Enum-like: biodata, obstetric, gynae, medical, surgical, allergies, family_social
  question_key  String
  answer        Json
  updated_at    DateTime @updatedAt

  patient       Patient  @relation(fields: [patient_id], references: [id])

  @@index([patient_id, domain])
  @@map("intake_responses")
}

model RiskAssessment {
  id             String   @id @default(uuid())
  patient_id     String
  tier           String   // LOW/MEDIUM/HIGH
  reasons        Json     // Array of strings
  engine_version String
  input_snapshot Json
  created_at     DateTime @default(now())

  patient        Patient  @relation(fields: [patient_id], references: [id])

  @@map("risk_assessments")
}

model Symptom {
  id           String   @id @default(uuid())
  patient_id   String
  symptom_key  String
  severity     String   // mild/moderate/severe
  notes        String?
  reported_at  DateTime @default(now())

  patient      Patient  @relation(fields: [patient_id], references: [id])

  @@index([patient_id, reported_at])
  @@map("symptoms")
}

model DangerAlert {
  id               String   @id @default(uuid())
  patient_id       String
  doctor_id        String?
  triggers         Json
  severity         String
  status           String   // open/acknowledged/resolved
  sms_sent_at      DateTime?
  whatsapp_sent_at DateTime?
  acknowledged_at  DateTime?
  created_at       DateTime @default(now())

  patient          Patient  @relation(fields: [patient_id], references: [id])
  doctor           Doctor?  @relation(fields: [doctor_id], references: [id])

  @@index([doctor_id, status])
  @@map("danger_alerts")
}

model Appointment {
  id              String   @id @default(uuid())
  patient_id      String
  doctor_id       String
  slot_start      DateTime
  slot_end        DateTime // 30 min later
  status          String   // booked/completed/cancelled/no_show
  idempotency_key String   @unique
  created_at      DateTime @default(now())

  patient         Patient  @relation(fields: [patient_id], references: [id])
  doctor          Doctor   @relation(fields: [doctor_id], references: [id])
  visits          Visit[]

  @@index([slot_start])
  @@index([doctor_id, slot_start])
  @@map("appointments")
}

model Visit {
  id             String   @id @default(uuid())
  appointment_id String
  doctor_notes   String?
  created_at     DateTime @default(now())

  appointment    Appointment @relation(fields: [appointment_id], references: [id])

  @@map("visits")
}

/// One row per calendar-day the patient opened the app (conversion / retention).
model PatientSiteVisit {
  id         String   @id @default(uuid())
  patient_id String
  visited_at DateTime @default(now())
  path       String?

  patient    Patient  @relation(fields: [patient_id], references: [id], onDelete: Cascade)

  @@index([patient_id, visited_at])
  @@map("patient_site_visits")
}

model EducationModule {
  id           String   @id @default(uuid())
  week_number  Int?     // legacy single week; new content uses stage
  stage        String?  // general | trimester_1 | trimester_2 | trimester_3 | postpartum (null = derived from week_number)
  title        String
  summary      String?
  content_type String?  // video/article/audio; null on legacy rows (type inferred from URLs)
  video_url    String?
  audio_url    String?
  article_url  String?  // optional external link for an article
  body         String?  // article text written by a doctor
  transcript   String?  // video transcript (legacy rows may hold a Pidgin summary)
  status       String   // draft/reviewed/published
  created_by   String?  // doctor id of the author
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@map("education_modules")
}

model EducationProgress {
  id           String   @id @default(uuid())
  patient_id   String
  module_id    String
  completed_at DateTime @default(now())

  patient      Patient  @relation(fields: [patient_id], references: [id])

  @@map("education_progress")
}

/// Patient comments on education lessons and doctor replies (one level of replies)
model EducationComment {
  id          String   @id @default(uuid())
  module_id   String
  /// Set on doctor replies; null on top-level patient comments
  parent_id   String?
  author_type String   // patient | doctor
  patient_id  String?
  doctor_id   String?
  body        String
  /// Hidden by a doctor (e.g. inappropriate); not shown to patients
  hidden      Boolean  @default(false)
  created_at  DateTime @default(now())

  patient     Patient? @relation(fields: [patient_id], references: [id], onDelete: Cascade)
  doctor      Doctor?  @relation(fields: [doctor_id], references: [id], onDelete: Cascade)

  @@index([module_id, created_at])
  @@index([parent_id])
  @@map("education_comments")
}

model NotificationsLog {
  id                  String   @id @default(uuid())
  channel             String   // sms/whatsapp/email
  recipient           String
  payload             Json
  provider_message_id String?
  status              String
  error               String?
  sent_at             DateTime @default(now())

  @@map("notifications_log")
}

model AuditLog {
  id            String   @id @default(uuid())
  actor_type    String
  actor_id      String
  action        String
  resource_type String
  resource_id   String
  before        Json?
  after         Json?
  created_at    DateTime @default(now())

  @@map("audit_logs")
}

model SystemConfig {
  id                String   @id @default(uuid())
  on_call_doctor_id String?
  updated_at        DateTime @updatedAt

  @@map("system_config")
}
